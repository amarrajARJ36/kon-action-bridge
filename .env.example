# ==============================================================================
# KON Action Bridge — Root Environment Configuration Template
# Copy to .env in backend/ and frontend/ as needed
# ==============================================================================

# Backend Application Settings
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=kon-action-bridge-super-secure-secret-key-min-32-chars-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Layer (Optional - System includes 100% deterministic fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./kon_action_bridge.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

